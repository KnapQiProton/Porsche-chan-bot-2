#!/usr/bin/env bash
# =============================================================
#  bot — helper CLI untuk Porsche-chan Discord Bot
#  Usage: ./bot <command>
# =============================================================

WORKFLOW_NAME="Porsche-chan Discord Bot"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

print_header() {
  echo -e "${CYAN}${BOLD}"
  echo "  🏎️  Porsche-chan Bot CLI"
  echo -e "${RESET}"
}

cmd_help() {
  print_header
  echo -e "${BOLD}Usage:${RESET}  ./bot <command>"
  echo ""
  echo -e "${BOLD}Commands:${RESET}"
  echo -e "  ${GREEN}start${RESET}      Jalankan bot (dev mode tsx server.ts)"
  echo -e "  ${GREEN}prod${RESET}       Jalankan bot production (node dist/server.cjs)"
  echo -e "  ${YELLOW}stop${RESET}       Matikan bot"
  echo -e "  ${CYAN}restart${RESET}    Restart bot (stop lalu start)"
  echo -e "  ${CYAN}logs${RESET}       Lihat log bot"
  echo -e "  ${CYAN}status${RESET}     Cek apakah bot sedang berjalan"
  echo -e "  ${CYAN}build${RESET}      Build frontend dan bundle server.cjs"
  echo -e "  ${CYAN}typecheck${RESET}  Cek TypeScript errors (lint)"
  echo -e "  ${CYAN}help${RESET}       Tampilkan pesan ini"
  echo ""
  echo -e "${BOLD}Contoh:${RESET}"
  echo "  ./bot start"
  echo "  ./bot restart"
  echo "  ./bot build"
  echo ""
}

cmd_start() {
  echo -e "${GREEN}▶ Menjalankan bot...${RESET}"
  pnpm run dev
}

cmd_prod() {
  echo -e "${GREEN}▶ Menjalankan bot production...${RESET}"
  pnpm run start
}

cmd_stop() {
  echo -e "${YELLOW}■ Menghentikan bot...${RESET}"
  PID=$(pgrep -f "dist/server.cjs|server.ts" 2>/dev/null)
  if [ -z "$PID" ]; then
    echo -e "${RED}Bot tidak sedang berjalan.${RESET}"
  else
    kill "$PID" 2>/dev/null
    echo -e "${GREEN}Bot dihentikan (PID: $PID).${RESET}"
  fi
}

cmd_restart() {
  echo -e "${CYAN}↺ Merestart bot...${RESET}"
  cmd_stop
  sleep 1
  cmd_start
}

cmd_logs() {
  echo -e "${CYAN}📋 Menjalankan bot dengan log output langsung (Ctrl+C untuk keluar)...${RESET}"
  pnpm run dev
}

cmd_status() {
  echo -e "${BOLD}Status Bot:${RESET}"
  PID=$(pgrep -f "dist/server.cjs|server.ts" 2>/dev/null)
  if [ -n "$PID" ]; then
    echo -e "  ${GREEN}● RUNNING${RESET} (PID: $PID)"
  else
    echo -e "  ${RED}○ STOPPED${RESET}"
  fi
  echo ""
  echo -e "${BOLD}Secrets yang terkonfigurasi:${RESET}"
  check_secret() {
    if [ -n "${!1}" ]; then
      echo -e "  ${GREEN}✓${RESET} $1"
    else
      echo -e "  ${RED}✗${RESET} $1 ${YELLOW}(tidak diset)${RESET}"
    fi
  }
  check_secret "DISCORD_BOT_TOKEN"
  check_secret "GEMINI_API_KEY"
  check_secret "GROQ_API_KEY"
  check_secret "MISTRAL_API_KEY"
  check_secret "DEEPSEEK_API_KEY"
  check_secret "OPENROUTER_API_KEY"
  check_secret "PORT"
}

cmd_build() {
  echo -e "${CYAN}🔨 Building bot & frontend...${RESET}"
  pnpm run build
}

cmd_typecheck() {
  echo -e "${CYAN}🔍 Mengecek TypeScript...${RESET}"
  pnpm run lint
}

COMMAND="${1:-help}"

case "$COMMAND" in
  start)      cmd_start ;;
  stop)       cmd_stop ;;
  restart)    cmd_restart ;;
  logs)       cmd_logs ;;
  status)     cmd_status ;;
  build)      cmd_build ;;
  typecheck)  cmd_typecheck ;;
  help|--help|-h) cmd_help ;;
  *)
    echo -e "${RED}Command tidak dikenal: '$COMMAND'${RESET}"
    echo ""
    cmd_help
    exit 1
    ;;
esac
