# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Gemini Model: default is gemini-3.8-flash (auto-fallbacks to gemini-2.5-flash)
GEMINI_MODEL="gemini-3.8-flash"


# DISCORD_BOT_TOKEN: Token for Porsche-chan Discord Bot
DISCORD_BOT_TOKEN="MY_DISCORD_BOT_TOKEN"

# Optional AI Provider Fallback Keys:
GROQ_API_KEY=""
MISTRAL_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""
VOICEMASTER_CATEGORY_ID=""

# YouTube Authentication for Hosting / Railway:
# 1. Base64 string of cookies.txt exported from browser, OR
# 2. Raw Netscape cookies text. (Use /cookies command in Discord to generate this Base64 easily!)
YOUTUBE_COOKIE=""

# Optional: Override yt-dlp player client (default: ios,web,mweb)
YOUTUBE_PLAYER_CLIENT=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
